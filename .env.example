# Local development defaults. Copy to .env at the repository root.
# These credentials are for the Docker Compose Postgres service only.

DATABASE_URL=postgresql://queuelab:queuelab@localhost:5432/queuelab?schema=public
REDIS_URL=redis://localhost:6379
PORT=3000
WEB_ORIGIN=http://localhost:4200
STORAGE_PATH=storage
DEMO_USER_EMAIL=demo@queuelab.dev
WORKER_CONCURRENCY=2
# BullMQ stalled-job recovery. One stall is rerun. A second stall fails the execution.
# BULLMQ_LOCK_DURATION_MS=30000
# BULLMQ_STALLED_INTERVAL_MS=30000
# BULLMQ_MAX_STALLED_COUNT=1
# Reconciler. Pending rows younger than the age are left for the request that created them.
# RECONCILE_INTERVAL_MS=10000
# PENDING_ENQUEUE_MIN_AGE_MS=15000
# STUCK_JOB_AFTER_MS=120000
# RECONCILE_CLAIM_LEASE_MS=20000
