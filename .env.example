# Local development defaults. Copy to .env at the repository root.
# These credentials are for the Docker Compose Postgres service only.

DATABASE_URL=postgresql://queuelab:queuelab@localhost:5432/queuelab?schema=public
REDIS_URL=redis://localhost:6379
PORT=3000
WEB_ORIGIN=http://localhost:4200
# Local directory used only when S3_BUCKET is unset. Production refuses to boot without a bucket.
STORAGE_PATH=storage
# S3_BUCKET=queuelab
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
DEMO_USER_EMAIL=demo@queuelab.dev
# Leave OIDC_ISSUER empty only on localhost. The email form is not served for any other host.
# Production refuses to boot unless every value below is set. The issuer, redirect, and
# WEB_ORIGIN must be https. AUTH_COOKIE_SECRET must be at least 16 characters.
# Cookies are HttpOnly and SameSite=Lax so the provider can redirect back.
# Production also marks them Secure. Browser mutations send X-QueueLab-Request.
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=queuelab
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://app.example.com/api/v1/auth/callback
# AUTH_COOKIE_SECRET=
# COOKIE_SECURE=true
WORKER_CONCURRENCY=2
# BullMQ stalled-job recovery. One stall is rerun. A second stall fails the execution.
# BULLMQ_LOCK_DURATION_MS=30000
# BULLMQ_STALLED_INTERVAL_MS=30000
# BULLMQ_MAX_STALLED_COUNT=1
# Reconciler. Pending rows younger than the age are left for the request that created them.
# RECONCILE_INTERVAL_MS=10000
# PENDING_ENQUEUE_MIN_AGE_MS=15000
# STUCK_JOB_AFTER_MS=120000
# RECONCILE_CLAIM_LEASE_MS=20000
