{
  "name": "queuelab",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:packages": "pnpm --filter @queuelab/database build && pnpm --filter @queuelab/shared-types build",
    "dev": "pnpm build:packages && concurrently -n api,worker,web -c cyan,magenta,yellow \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:api": "pnpm --filter @queuelab/api dev",
    "dev:worker": "pnpm --filter @queuelab/worker dev",
    "dev:web": "pnpm --filter @queuelab/web start",
    "db:generate": "pnpm --filter @queuelab/database generate",
    "db:migrate": "pnpm --filter @queuelab/database migrate",
    "db:seed": "pnpm --filter @queuelab/shared-types build && pnpm --filter @queuelab/database seed",
    "docker:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker-compose.yml down",
    "test": "pnpm --filter @queuelab/shared-types build && pnpm --filter @queuelab/database build && pnpm --filter @queuelab/shared-types test && pnpm --filter @queuelab/worker test && pnpm --filter @queuelab/api test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract",
      "prisma"
    ]
  }
}
